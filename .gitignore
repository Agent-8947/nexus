# === NEXUS PARANOID .gitignore ===

# Secrets & Environment (CRITICAL)
.env
.env.*
.env.mcp
**/.env
**/.env.*

# Python Architecture
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node Architecture
node_modules/
.astro/
.next/
dist/
out/

# IDE & OS
.vscode/
.idea/
.project
.classpath
.settings/
Thumbs.db
Desktop.ini
.DS_Store

# Database & Vectors
*.db
*.sqlite3
*.bin
*.pkl
**/*.db
**/*.sqlite3

# NEXUS Reports & Outputs (TOTAL BLOCK)
**/reports/
**/outputs/
**/logs/
**/*.log
**/*.pdf
**/*.docx
**/*.html (except templates)
!**/templates/*.html
!PROJECT/WIKI-DASHBOARD/index.html

# Tools & Temp
tmp/
*.tmp
.temp/
.cache/
.pytest_cache/
.tox/

# Submodules & External (Only Structure allowed)
PROJECT/EXTERNAL-LIBRARY/**/.git/
PROJECT/EXTERNAL-LIBRARY/**/.github/

PROJECT/EXTERNAL-LIBRARY/
